# ZgentFlow local development overrides
# `make dev-app` supplies the fixed PostgreSQL, pgvector, local-file and
# docreader configuration. Only set values here when overriding defaults.

# Application ports
ZEALRAG_APP_PORT=8081
ZEALRAG_DB_PORT=54329
ZEALRAG_REDIS_PORT=6389
ZEALRAG_DOCREADER_PORT=50061

# Project-local directories
# ZEALRAG_RUNTIME_DIR=/absolute/path/to/.runtime
# ZEALRAG_DATA_DIR=/absolute/path/to/.local-data

# Local database credentials
DB_USER=zealrag
DB_PASSWORD=zealrag-local
DB_NAME=zealrag_main

# Development behavior
GIN_MODE=debug

# Registration and email-code login (QQ Mail uses an authorization code,
# not the mailbox login password). Keep real credentials in .env only.
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=ZgentFlow

# false for local HTTP; set true when the public site is served over HTTPS.
AUTH_COOKIE_SECURE=false
# Optional: defaults to SYSTEM_AES_KEY when omitted.
# AUTH_CODE_SECRET=
# CORS_ALLOWED_ORIGINS=https://your-zgentflow.example.com

# Optional Ollama endpoint
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Langfuse observability
# LANGFUSE_ENABLED=true
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Optional web-search provider keys are configured in the ZgentFlow settings UI.
# Model provider URLs and API keys are also added through the settings UI.
